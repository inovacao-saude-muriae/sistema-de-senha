# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
tests/fixtures/news/*
!tests/fixtures/news/.gitkeep

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

VERCEL_ENV.md
.env
.env.local

# typescript
*.tsbuildinfo
next-env.d.ts
.eslintignore
/.idea/inspectionProfiles/Project_Default.xml
/.idea/.gitignore
/.idea/jsLibraryMappings.xml
/.idea/misc.xml
/.idea/modules.xml
/.idea/php.xml
/.idea/sistemadesenha.iml
/.idea/vcs.xml
/bun.lock