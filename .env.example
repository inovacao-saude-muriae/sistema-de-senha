
# ── Postgres local (Docker) ──────────────────────────────────────
POSTGRES_DB=sistemadesenha
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistemadesenha?schema=public"

# ── Camada de dados ──────────────────────────────────────────────
# auth, users, news, queue, read usam Prisma
# Realtime usa SSE (Server-Sent Events) — não depende de backend
DATA_LAYER="postgres"

# ── Auth.js ──────────────────────────────────────────────────────
AUTH_TRUST_HOST=true
AUTH_SECRET="gere-um-secret-com-openssl-rand-base64-32"
NEXTAUTH_URL="https://atendimento.saudedigitalmuriae.com.br"

# ── S3 (quando DATA_LAYER="postgres") ───────────────────
# Gere os valores com: openssl rand -hex 16 (ACCESS_KEY com prefixo GK) / openssl rand -hex 32 (SECRET_KEY)
# O bucket é criado automaticamente na primeira execução.
S3_ENDPOINT="http://localhost:3900"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="news-images"
S3_PUBLIC_URL="http://news-images.localhost:3902"

# ── S3 para testes (opcional, usado pelo vitest) ──────────────────
# Os testes usam um bucket separado para não misturar com dados de dev.
# Configure abaixo os valores para o bucket de teste.
S3_ENDPOINT_TEST="http://localhost:3900"
S3_REGION_TEST="us-east-1"
S3_ACCESS_KEY_TEST=""
S3_SECRET_KEY_TEST=""
S3_BUCKET_TEST="news-images-test"
S3_PUBLIC_URL_TEST="http://news-images-test.localhost:3902"